{
  "name": "petri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings=0",
    "check": "tsx scripts/check.ts",
    "trust-report": "tsx scripts/trust-report.ts",
    "evolution:gate": "tsx --env-file-if-exists=.env.local scripts/evolution-gate.ts",
    "evolution:triage-input": "tsx --env-file-if-exists=.env.local scripts/evolution-triage-input.ts",
    "evolution:create-issues": "tsx --env-file-if-exists=.env.local scripts/evolution-create-issues.ts",
    "evolution:agent-config": "tsx scripts/evolution-agent-config.ts",
    "evolution:pick-issue": "tsx scripts/evolution-pick-issue.ts",
    "evolution:feedback-status": "tsx --env-file-if-exists=.env.local scripts/evolution-feedback-status.ts",
    "evolution:open-pr": "tsx --env-file-if-exists=.env.local scripts/evolution-open-pr.ts",
    "evolution:check-patch": "tsx scripts/evolution-check-patch.ts",
    "evolution:build-report": "tsx scripts/evolution-build-report.ts",
    "evolution:pr-context": "tsx scripts/evolution-pr-context.ts",
    "evolution:verify-plan": "tsx scripts/evolution-verify-plan.ts",
    "evolution:verdict": "tsx scripts/evolution-verdict.ts",
    "evolution:automerge": "tsx scripts/evolution-automerge.ts",
    "evolution:post-merge": "tsx --env-file-if-exists=.env.local scripts/evolution-post-merge.ts",
    "evolution:pr-closed": "tsx --env-file-if-exists=.env.local scripts/evolution-pr-closed.ts",
    "evolution:pause": "tsx scripts/evolution-pause.ts pause",
    "evolution:resume": "tsx scripts/evolution-pause.ts resume",
    "evolution:record-run": "tsx --env-file-if-exists=.env.local scripts/evolution-record-run.ts",
    "evolution:weekly": "tsx --env-file-if-exists=.env.local scripts/evolution-weekly.ts",
    "evolution:guardian": "tsx scripts/evolution-guardian.ts",
    "evolution:postmortem": "tsx scripts/evolution-postmortem.ts",
    "app:flags": "tsx --env-file-if-exists=.env.local scripts/app-flags.ts",
    "boundaries": "node scripts/check-boundaries.ts",
    "features": "tsx scripts/check-features.ts",
    "featuremap": "tsx scripts/featuremap.ts",
    "featuremap:check": "tsx scripts/check-featuremap.ts",
    "protected-paths": "node scripts/check-protected-paths.ts",
    "pr-size": "node scripts/check-pr-size.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "evals": "tsx scripts/evals.ts",
    "evals:report": "tsx scripts/evals-report.ts",
    "verify:up": "tsx scripts/verify.ts up",
    "verify:down": "tsx scripts/verify.ts down",
    "verify:flow": "tsx scripts/verify.ts flow",
    "verify:script": "tsx scripts/verify.ts script",
    "verify:all": "tsx scripts/verify.ts all",
    "verify:compare": "tsx scripts/verify.ts compare",
    "new:feature": "tsx scripts/new-feature.ts",
    "setup:secrets": "tsx scripts/setup-secrets.ts",
    "setup:labels": "tsx scripts/setup-labels.ts",
    "env:local": "tsx scripts/env-local.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push:prod": "tsx scripts/db-push-prod.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/supabase/database.types.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.8.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.17",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
