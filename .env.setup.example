# Copy to .env.setup (gitignored), fill in, check with: pnpm setup:secrets   then push with: pnpm setup:secrets --apply
# Each value is pasted once here and pushed to GitHub secrets/variables and Vercel env.

# REQUIRED · Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED · Supabase dashboard → Project Settings → API Keys → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED · Supabase dashboard → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED · Leave blank: generated for you
RATE_LIMIT_SALT=

# optional · Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# optional · Sentry organization slug (from the Sentry URL)
SENTRY_ORG=

# optional · Sentry project slug
SENTRY_PROJECT=

# optional · Sentry → Settings → Auth Tokens (Project: Read, Release: Admin, Issue & Event: Read, Organization: Read)
SENTRY_AUTH_TOKEN=

# REQUIRED · Set in GitHub by `/install-github-app`; leave blank unless rotating (then paste `claude setup-token` output)
CLAUDE_CODE_OAUTH_TOKEN=

# optional · The evolution GitHub App's Client ID, from its General page (docs/MANUAL_STEPS.md step 10)
EVOLUTION_APP_CLIENT_ID=

# optional · The evolution GitHub App's private key: paste the whole .pem file between double quotes, keeping its lines
EVOLUTION_APP_PRIVATE_KEY=

# optional · vercel.com/account/settings/tokens → create a token scoped to the petri project (guardian rollback)
VERCEL_TOKEN=

# optional · Leave blank: read from .vercel/project.json after `vercel link`
VERCEL_ORG_ID=

# optional · Leave blank: read from .vercel/project.json after `vercel link`
VERCEL_PROJECT_ID=
