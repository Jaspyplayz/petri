# Copy to .env.setup (gitignored), fill in, then run: pnpm setup:secrets
# Each value is pasted once here and pushed to GitHub secrets/variables and Vercel env.

# REQUIRED · Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED · Supabase dashboard → Project Settings → API Keys → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED · Supabase dashboard → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED · Leave blank: generated for you
RATE_LIMIT_SALT=

# optional · Sentry → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=

# optional · Sentry organization slug (from the Sentry URL)
SENTRY_ORG=

# optional · Sentry project slug
SENTRY_PROJECT=

# optional · Sentry → Settings → Auth Tokens (scopes: project:read, event:read, project:releases)
SENTRY_AUTH_TOKEN=

# REQUIRED · Run `claude setup-token` and paste the token
CLAUDE_CODE_OAUTH_TOKEN=

# optional · Only if needed: fine-grained PAT for this repo (Contents, Pull requests, Issues: read/write)
EVOLUTION_BOT_TOKEN=

# optional · vercel.com/account/tokens → create a token (used by the guardian for instant rollback)
VERCEL_TOKEN=

# optional · Leave blank: read from .vercel/project.json after `vercel link`
VERCEL_ORG_ID=

# optional · Leave blank: read from .vercel/project.json after `vercel link`
VERCEL_PROJECT_ID=
