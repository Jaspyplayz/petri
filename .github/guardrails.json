{
  "protectedPaths": [
    ".github/**",
    ".evolution/**",
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    "**/AGENTS.md",
    "STARTER_PROMPT.md",
    ".claude/**",
    ".mcp.json",
    "**/.env*",
    "**/eslint.config.*",
    "lint-rules/**",
    "evals/**",
    "tsconfig*.json",
    ".dependency-cruiser.cjs",
    "next.config.*",
    "scripts/**",
    "lefthook*",
    ".config/lefthook*",
    ".lefthook*",
    "**/.gitattributes",
    ".gitleaks.toml",
    ".gitleaksignore",
    "vitest.config.*",
    "playwright.config.*",
    "package.json",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".pnpmfile.cjs",
    ".pnpmfile.mjs",
    "patches/**",
    ".npmrc",
    "vercel.json",
    "supabase/migrations/**",
    "supabase/config.toml",
    "supabase/seed.sql",
    "src/shared/testing/**",
    "src/shared/ui/effects/**",
    "src/shared/env.ts",
    "src/shared/server-env-schema.ts",
    "src/shared/lib/log.ts",
    "src/shared/lib/sentry-options.ts",
    "src/instrumentation.ts",
    "src/instrumentation-client.ts"
  ],
  "agentPullRequests": {
    "labels": [
      "evolution"
    ],
    "branchPrefixes": [
      "evo/",
      "claude/"
    ],
    "authors": [
      "claude[bot]",
      "github-actions[bot]"
    ]
  },
  "humanOnlyLabels": {
    "protectedPaths": "protected-ok",
    "prSize": "size-ok"
  },
  "prSize": {
    "maxChangedLines": 400,
    "ignoredPaths": [
      "pnpm-lock.yaml",
      "**/package-lock.json",
      "**/yarn.lock",
      "src/shared/supabase/database.types.ts",
      "src/features/registry.ts",
      "FEATURE_MAP.md"
    ]
  },
  "migrations": {
    "paths": [
      "supabase/migrations/**"
    ],
    "allowedFromTrustLevel": 4
  },
  "trustConfigPath": ".evolution/config.json",
  "pauseFilePath": ".evolution/PAUSED"
}
