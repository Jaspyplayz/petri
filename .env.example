# Local dev: don't copy this file. Run `pnpm db:start` then `pnpm env:local`,
# which writes .env.local (gitignored) from `supabase status`.
# Real values live only in GitHub Actions secrets and Vercel env (pnpm setup:secrets).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any random string of 16+ chars (env:local generates one).
RATE_LIMIT_SALT=

# Optional. Without a DSN, Sentry is a no-op.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
